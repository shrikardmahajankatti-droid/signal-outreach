DATABASE_URL=            # Neon
GEMINI_API_KEY=
GEMINI_MODEL=            # latest Gemini Flash (defaults in code if empty)
TAVILY_API_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OUTREACH_FROM=           # e.g. rohit@outreach.<domain>
ROHIT_EMAIL=
TEST_INBOX=
HUBSPOT_ACCESS_TOKEN=    # private app token or service key (CRM companies/contacts/deals + deal schemas)
CRON_SECRET=
DEMO_MODE=true
APP_URL=
ALLOW_LIVE_SEND=false   # true = the Settings toggle may turn DEMO_MODE off (real founder sends)
JINA_API_KEY=           # optional; Jina Reader works without a key at lower rate limits
HUNTER_API_KEY=          # optional; Hunter.io email finder/verifier (free plan ≈ 50 credits/month)
HUNTER_MONTHLY_CAP=45    # Signal never makes more Hunter calls than this per month
CRON_END_DATE=2026-11-30 # crons no-op after this date (Asia/Kolkata)
